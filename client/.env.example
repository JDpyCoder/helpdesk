# Sentry error reporting for the browser app (@sentry/react). Copy to client/.env.
# Use the DSN of a Sentry "React" project (Project Settings → Client Keys). While unset, nothing is sent.
# The DSN is public: Vite builds it into the client bundle.
VITE_SENTRY_DSN="https://58d0827f69bd55d4c87577b4768e2621@o4512268868386816.ingest.us.sentry.io/4512268899057664"
SENTRY_ENVIRONMENT=""
# Optional: environment name shown in Sentry (default: Vite's mode, "development" or "production")
# VITE_SENTRY_ENVIRONMENT=production
# Optional: support address shown in the banner and "Need help?" button (default: jaydeep.helpdesk@agentmail.to).
# Built into the bundle, so rebuild/redeploy after changing it.
# VITE_SUPPORT_EMAIL=support@example.com
