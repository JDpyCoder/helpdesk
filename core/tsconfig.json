{
  // Shared code imported as TypeScript source by both the client (Vite) and the server (Bun).
  // No runtime-specific types: everything here must run in the browser and in Bun.
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": [],

    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src"],
  // Specs run under bun test and import "bun:test"; keeping them out leaves the shared code free of Bun types
  "exclude": ["src/**/*.test.ts"]
}
