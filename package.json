{
  "name": "helpdesk",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "overrides": {
    "mysql2": "^3.24.5"
  },
  "scripts": {
    "dev": "bun run --parallel --filter '*' dev",
    "dev:client": "bun run --filter client dev",
    "dev:server": "bun run --filter server dev",
    "build": "bun run --filter client build",
    "typecheck": "tsc --noEmit -p . && bun run --filter server typecheck && bun run --filter client build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
