{
  "name": "helpdesk",
  "private": true,
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "bun run --parallel --filter '*' dev",
    "dev:client": "bun run --filter client dev",
    "dev:server": "bun run --filter server dev",
    "build": "bun run --filter client build",
    "typecheck": "bun run --filter server typecheck && bun run --filter client build"
  }
}
