# Used only by Playwright (bun run test:e2e). Copy to server/.env.test.
# The e2e run starts its own API and client on these ports and resets this database
# before every run — its name must end in "_test".
PORT=3001
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/helpdesk_test?schema=public"

# Generate with: openssl rand -base64 32 (don't reuse the dev secret)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL=http://localhost:3001
CLIENT_ORIGIN=http://localhost:5174

# Admin seeded into the test database before each run (at least 12 characters)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=test-admin-password
SEED_ADMIN_NAME=Admin
