PORT=3000
# Express "trust proxy" value: which reverse proxies may set X-Forwarded-For.
# Defaults to "loopback" (the Vite dev proxy). In production set your proxy's IP/CIDR,
# a hop count, or "false" when the server is exposed directly.
# TRUST_PROXY=loopback
# Header that carries the client IP when the platform's proxy doesn't use X-Forwarded-For.
# On Railway set it to x-real-ip, on Render to true-client-ip (their edges overwrite those headers). Leave unset elsewhere,
# since clients could send the header themselves without a proxy that overwrites it.
# CLIENT_IP_HEADER=x-real-ip
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/helpdesk?schema=public"

# Better Auth — generate the secret with: openssl rand -base64 32
# Required, at least 32 characters — the server refuses to start without it
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL=http://localhost:3000
# Browser origin allowed to call /api/auth (Vite dev server). In production the server serves the
# client itself, so this and BETTER_AUTH_URL are both the app's public URL. On Render both default to
# RENDER_EXTERNAL_URL (the onrender.com URL) when unset.
CLIENT_ORIGIN=http://localhost:5173

# Initial admin created by `bun run db:seed`
SEED_ADMIN_EMAIL=admin@example.com
# At least 12 characters; the seed refuses this placeholder
SEED_ADMIN_PASSWORD=change-me-please

# Shared secret for POST /api/inbound-email, sent as "Authorization: Bearer <secret>".
# Generate with: openssl rand -base64 32. While unset, the endpoint answers 503.
INBOUND_EMAIL_SECRET=""

# Google Gemini API key for the AI features: "Polish" on the reply form and "Summarize" on the ticket page (Vercel AI SDK, @ai-sdk/google).
# Create one at https://aistudio.google.com/apikey. While unset, POST /api/tickets/:id/replies/polish and /api/tickets/:id/summary answer 503.
GOOGLE_GENERATIVE_AI_API_KEY=""
# Optional: Gemini model id (default gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Sentry error reporting (@sentry/bun): DSN of a Sentry "Bun" or "Node" project (Project Settings → Client Keys).
# While unset, nothing is sent. Every console.error is reported, including handled 500s and background job failures.
SENTRY_DSN=""
# Optional: environment name shown in Sentry (default: NODE_ENV, else "development")
# SENTRY_ENVIRONMENT=production

# Auto-resolution of new tickets (needs the Gemini key above): the AI answers from this Markdown knowledge base.
# Defaults to server/knowledge-base.md; with no file there, new tickets go straight to agents.
# KNOWLEDGE_BASE_PATH=./knowledge-base.md
# Sender address shown on the AI's answers (default support@example.com). The AI's answers are never emailed.
# SUPPORT_EMAIL=support@example.com

# AgentMail (https://agentmail.to), see agentmail-setup.md. Customers email the inbox, which opens tickets; agent
# replies to those tickets are emailed back in the same thread. Other tickets are never emailed.
# API key from the AgentMail console. While it or the inbox is unset, replies to email tickets show "Email not sent".
AGENTMAIL_API_KEY=""
# The inbox's id, which is its address, e.g. support@agentmail.to (create it in the console or with the API)
AGENTMAIL_INBOX_ID=""
# Signing secret (whsec_…) of the console webhook pointing at https://<your-host>/api/webhooks/agentmail, with events
# message.received, message.sent, message.delivered, message.bounced, message.rejected. While unset, the webhook answers 503.
AGENTMAIL_WEBHOOK_SECRET=""
