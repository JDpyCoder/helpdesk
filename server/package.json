    "better-auth": "^1.7.7",
    "core": "workspace:*",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "imapflow": "^2.5.2",
    "mailparser": "^3.9.40",
    "nodemailer": "^10.1.2",
    "pg-boss": "^12.38.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
